  "locations": [
    {
      "id": "pooh-house",
      "title": "Pooh’s House",
      "shortitle": "Pooh",
      "description": "Pooh’s welcoming home beneath a great oak, with honey pots, a log seat, and paths through the sunlit wood.",
      "media": {
        "type": "image360",
        "url": "pooh-house-360.png"
      }
    },
    {
      "id": "piglet-house",
      "title": "Piglet’s House",
      "shortitle": "Piglet",
      "description": "Piglet’s tiny home at the foot of an enormous beech tree, surrounded by violets, ferns, and fallen leaves.",
      "media": {
        "type": "image360",
        "url": "piglet-house-360.png"
      }
    },
    {
      "id": "rabbit-house",
      "title": "Rabbit’s House",
