{
  "url": "https://zodiacinnovations.com/aetheratlas/examples/pooh/pooh.aetheratlas",
  "id": "magesteve.pooh",
  "version": "1.0.0",
  "name": "100 Acres Woods",
  "details": {
    "media": "ai",
    "description": "Explore eleven woodland locations inspired by A. A. Milne’s original Winnie-the-Pooh stories, with AI-created panoramic artwork.",
    "author": {
      "creatorid": "magesteve",
      "name": "Steve Sheets",
      "email": "magesteve@mac.com",
      "registeredid": "magesteve"
    },
    "initiallocation": "pooh-house",
    "creationdate": "2026/11/04",
    "lastrevision": "2026/11/04",
    "defaults": {
      "panoramadegrees": 270,
      "environment": {
        "type": "color",
        "color": "black"
      },
      "hud-1": "exit",
      "hud-2": "shortlist",
      "exitstring": "Do you wish to leave 100 Acres Woods?",
      "showhud": true,
      "showmap": false,
      "hudormap": true,
      "hud-3": "mapswitch"
    },
    "initialmap": "woodland"
  },
  "formatversion": 1,
  "maps": [
    {
