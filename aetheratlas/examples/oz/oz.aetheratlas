      "registeredid": "magesteve"
    },
    "initiallocation": "munchkin-country",
    "creationdate": "2026/11/01",
    "lastrevision": "2026/11/03",
    "defaults": {
      "panoramadegrees": 270,
      "environment": {
        "type": "color",
        "color": "black"
      },
      "hud-1": "exit",
      "hud-2": "shortlist",
      "exitstring": "Do you wish to leave the World of Oz?"
    }
  },
