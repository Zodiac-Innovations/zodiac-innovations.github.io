  "name": "Yosemite Valley",
  "details": {
    "media": "photo",
    "description": "Explore Yosemite Valley through public-domain photographs: Tunnel View, Bridalveil Fall, El Capitan, Yosemite Lodge, Yosemite Falls, Glacier Point, Half Dome, and the historic Firefall.",
    "author": {
      "creatorid": "magesteve",
      "name": "Steve Sheets",
      "email": "magesteve@mac.com",
      "registeredid": "magesteve"
    },
    "initiallocation": "tunnel-view",
    "creationdate": "2026/11/02",
    "lastrevision": "2026/11/03",
    "defaults": {
      "panoramadegrees": 270,
      "environment": {
        "type": "color",
        "color": "black"
      },
      "hud-1": "exit",
      "hud-2": "list"
    }
  },
  "formatversion": 1,
  "maps": [
    {
      "title": "Yosemite Valley Map",
      "image": "https://upload.wikimedia.org/wikipedia/commons/5/5c/NPS_yosemite-valley-map.jpg",
      "pinstyle": "pin",
      "pins": []
    }
  ],
  "locations": [
    {
      "id": "tunnel-view",
      "title": "Tunnel View",
      "description": "A winter view into Yosemite Valley from Tunnel View.",
