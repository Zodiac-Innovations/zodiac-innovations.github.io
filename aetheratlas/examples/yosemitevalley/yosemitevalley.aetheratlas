        "url": "https://upload.wikimedia.org/wikipedia/commons/0/0f/Bridalveil2.JPG"
      }
    },
    {
      "id": "valley-view",
      "title": "Valley View — El Capitan and Cathedral Rocks",
      "description": "El Capitan and Cathedral Rocks frame this view of the valley.",
      "media": {
        "type": "image",
        "url": "https://upload.wikimedia.org/wikipedia/commons/1/12/Yosemite_National_Park.jpg"
      }
    },
    {
      "id": "yosemite-lodge",
      "title": "Yosemite Lodge — Half Dome at Sunset",
      "description": "Half Dome at sunset, photographed near Yosemite Lodge; this is a view from the lodge area, not a photograph of its buildings.",
      "media": {
        "type": "image",
        "url": "https://upload.wikimedia.org/wikipedia/commons/d/db/Sunset_Half_Dome_Lodge.jpg"
      }
    },
    {
      "id": "yosemite-falls",
      "title": "Yosemite Falls",
      "description": "Yosemite Falls seen from the valley.",
      "media": {
        "type": "image",
        "url": "https://upload.wikimedia.org/wikipedia/commons/2/2f/Yosemite_Falls-600px.jpg"
      }
    },
    {
      "id": "glacier-point",
      "title": "Glacier Point Panorama",
      "description": "A wide panorama from Glacier Point across Yosemite Valley and Half Dome. This is not a full spherical image.",
