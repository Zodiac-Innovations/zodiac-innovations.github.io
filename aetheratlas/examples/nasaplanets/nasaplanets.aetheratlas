{
  "url": "https://zodiacinnovations.com/aetheratlas/examples/nasaplanets/nasaplanets.aetheratlas",
  "id": "magesteve.nasaplanets",
  "version": "1.0.0",
  "name": "NASA Planets",
  "details": {
    "media": "photo",
    "description": "Explore Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto, and the Sun through three NASA archive images per location. Multi-photo format proposal: this example uses media.type \"images\" with an images array. It requires future CLI and player support; the current single-image format does not support it.",
    "author": {
      "creatorid": "magesteve",
      "name": "Steve Sheets",
      "email": "magesteve@mac.com",
      "registeredid": "magesteve"
    },
    "initiallocation": "sun",
    "creationdate": "2026/11/04",
    "lastrevision": "2026/11/04",
    "defaults": {
      "environment": {
        "type": "color",
        "color": "black"
      },
      "hud-1": "exit",
      "hud-2": "list"
    }
  },
  "formatversion": 1,
  "maps": [],
  "locations": [
    {
      "id": "sun",
      "title": "Sun",
      "description": "Three NASA archive views of Sun. See the resource page and source records for processing notes and image credits.",
      "media": {
        "type": "images",
        "images": [
          {
            "title": "Almost Spotless — solar observation",
            "url": "https://assets.science.nasa.gov/content/dam/science/psd/photojournal/pia/pia21/pia21207/PIA21207.jpg"
          },
          {
            "title": "One Small Flare — solar observation",
            "url": "https://assets.science.nasa.gov/content/dam/science/psd/photojournal/pia/pia22/pia22244/PIA22244.jpg"
          },
          {
            "title": "Coronal Hole Front and Center — solar observation",
            "url": "https://assets.science.nasa.gov/content/dam/science/psd/photojournal/pia/pia15/pia15379/PIA15379.jpg"
          }
        ]
      }
    },
