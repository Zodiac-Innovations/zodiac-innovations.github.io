  "id": "magesteve.nasaplanets",
  "version": "1.0.0",
  "name": "NASA Planets",
  "details": {
    "media": "photo",
    "description": "Explore the Sun, Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune, and Pluto through one NASA archive image per location.",
    "author": {
      "creatorid": "magesteve",
      "name": "Steve Sheets",
      "email": "magesteve@mac.com",
      "registeredid": "magesteve"
    },
    "initiallocation": "sun",
    "creationdate": "2026/11/04",
    "lastrevision": "2026/11/04",
    "defaults": {
      "environment": {
        "type": "color",
        "color": "black"
      },
      "hud-1": "exit",
      "hud-2": "shortlist",
      "hud-3": "mapswitch",
      "showhud": true,
      "showmap": false,
      "hudormap": true
    },
    "initialmap": "solar-system"
  },
  "formatversion": 1,
  "maps": [
    {
      "id": "solar-system",
      "title": "Solar System Map",
      "image": "solarsystemmap.png",
